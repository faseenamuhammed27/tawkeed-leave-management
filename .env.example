# Used only by docker-compose.yml. Copy to .env and fill in. Never commit .env.
# Use letters and digits for POSTGRES_PASSWORD (it is embedded in a database URL).
POSTGRES_PASSWORD=CHANGE_ME
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Password for the seeded demo accounts.
SEED_DEMO_PASSWORD=CHANGE_ME
