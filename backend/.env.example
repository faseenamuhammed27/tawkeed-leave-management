# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# SQLAlchemy URL (psycopg 3 driver). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://tawkeed_app:CHANGE_ME@localhost:5432/tawkeed_leave
# Separate database used only by pytest. Never point this at the main database.
TEST_DATABASE_URL=postgresql+psycopg://tawkeed_app:CHANGE_ME@localhost:5432/tawkeed_leave_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Timezone used to decide what "today" is for leave date rules.
APP_TIMEZONE=Asia/Dubai

# Failed-login lockout.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password given to the demo accounts by: python -m app.seed
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
